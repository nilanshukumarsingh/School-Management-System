# ==============================================================================
# ScholaVerse Frontend - Environment Variables Template
# Copy this file to '.env' in this directory:
#   cp .env.example .env
# ==============================================================================

# Backend REST API Endpoint
# - For local standalone development: http://localhost:5000/api
# - For Vercel production deployment: /api (routes automatically via vercel.json)
VITE_API_BASE_URL=http://localhost:5000/api

# Institutional Metadata
VITE_APP_NAME=ScholaVerse
VITE_APP_VERSION=2.4.0
VITE_APP_ENVIRONMENT=development
