# ==============================================================================
# ScholaVerse Backend - Environment Variables Template
# Copy this file to '.env' in this directory:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Local: mongodb://127.0.0.1:27017/scholaverse
# Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/scholaverse?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/scholaverse

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_key_scholaverse_production_grade_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
